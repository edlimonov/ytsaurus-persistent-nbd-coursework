{
    max_failed_job_count = 1;
    enable_root_volume_disk_quota = %false;
    tasks = {
        nbd_course_two = {
            job_count = 1;
            command = "set -eu; findmnt -T /slot/sandbox/notebooks; findmnt -T /slot/sandbox/datasets; echo notebooks >> /slot/sandbox/notebooks/marker.txt; echo datasets >> /slot/sandbox/datasets/marker.txt; cat /slot/sandbox/notebooks/marker.txt /slot/sandbox/datasets/marker.txt; sync";
            disk_request = {disk_space = 1073741824;};
            nbd_volumes = {
                notebooks = {
                    disk_space = 1073741824;
                    nbd_disk = {dynamic_table = {table_path = "//tmp/nbd_course_two"; block_size = 4096;};};
                };
                datasets = {
                    disk_space = 1073741824;
                    nbd_disk = {dynamic_table = {table_path = "//tmp/nbd_course_two"; block_size = 4096;};};
                };
            };
            nbd_mounts = [
                {volume_id = "notebooks"; mount_path = "/slot/sandbox/notebooks";};
                {volume_id = "datasets"; mount_path = "/slot/sandbox/datasets";};
            ];
        };
    };
}
